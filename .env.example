# Variáveis da API (ronin-api). O pnpm dev / pnpm db:dev cria o .env a partir deste arquivo se ele
# não existir. O ronin-web lê daqui só o PORT (alvo do proxy /api) e o DATABASE_URL (servidor do
# banco kanban_e2e dos E2E).
# Os valores abaixo servem só para desenvolvimento. Nunca commite o .env.

# Banco principal da API. Padrão: PostgreSQL local de dev (pnpm dev / pnpm db:dev) na porta 5433,
# com dados em .data/postgres; nada a instalar. Alternativas: Docker (pnpm db:up, usa POSTGRES_PORT)
# ou Postgres nativo configurado por infra/postgres/local-setup.sql (troque a porta para 5432).
DATABASE_URL=postgres://kanban:kanban@127.0.0.1:5433/kanban

# Banco usado pelos testes de integração da API (Vitest). É truncado entre testes.
TEST_DATABASE_URL=postgres://kanban:kanban@127.0.0.1:5433/kanban_test

# Conexões máximas do pool do PostgreSQL da API (padrão 10).
DATABASE_POOL_MAX=10

# Pasta das migrations (opcional). Padrão: drizzle/ na raiz do repositório (pnpm db:migrate) ou
# <diretório atual>/drizzle (node dist/migrate.js).
# MIGRATIONS_DIR=drizzle

# Só para a alternativa Docker (pnpm db:up): porta do host publicada pelo docker-compose.
# 5433 casa com as URLs acima e não conflita com um Postgres nativo na 5432.
POSTGRES_PORT=5433

# Porta HTTP da API.
PORT=3000

# Interface de escuta da API. Em dev, só a máquina local; no container de produção use 0.0.0.0.
HOST=127.0.0.1

# Origem pública do app (o web do ronin-web): usada na checagem de CSRF e para montar links de
# convite/redefinição.
APP_ORIGIN=http://127.0.0.1:5310

# development | test | production (production liga cookie Secure/__Host- e desliga o Swagger UI).
NODE_ENV=development

# Código exigido no setup inicial (POST /api/setup), de 16 a 200 caracteres. Opcional em dev
# (vazio = setup sem código); obrigatório com NODE_ENV=production. Gere um aleatório com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SETUP_TOKEN=

# Em quem confiar para ler X-Forwarded-For (IP real em request.ip). Valores:
#   false            ignora o header (padrão; dev local sem proxy)
#   true             confia em qualquer um (forjável: evite)
#   1                número de saltos (1 a 100): confia só no proxy que conectou
#   10.0.0.0/8,::1   lista de IPs/CIDRs dos proxies (ex.: sub-rede do Caddy)
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Capa do quadro (Cloudflare R2). Tudo ou nada: sem as quatro, a capa fica desligada
# (features.boardCovers = false) e as rotas de capa respondem 503.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
