# O pnpm dev / pnpm db:dev cria o .env a partir deste arquivo se ele não existir.
# Os valores abaixo servem só para desenvolvimento. Nunca commite o .env.

# Banco principal da API. Padrão: PostgreSQL local de dev (pnpm dev / pnpm db:dev) na porta 5433,
# com dados em .data/postgres; nada a instalar. Alternativas: Docker (pnpm db:up, usa POSTGRES_PORT)
# ou Postgres nativo configurado por infra/postgres/local-setup.sql (troque a porta para 5432).
DATABASE_URL=postgres://kanban:kanban@127.0.0.1:5433/kanban

# Banco usado pelos testes de integração da API (Vitest). É truncado entre testes.
TEST_DATABASE_URL=postgres://kanban:kanban@127.0.0.1:5433/kanban_test

# Conexões máximas do pool do PostgreSQL da API (padrão 10).
DATABASE_POOL_MAX=10

# Só para a alternativa Docker (pnpm db:up): porta do host publicada pelo docker-compose.
# 5433 casa com as URLs acima e não conflita com um Postgres nativo na 5432.
POSTGRES_PORT=5433

# Porta HTTP da API.
PORT=3000

# Interface de escuta da API. Em dev, só a máquina local; no container de produção use 0.0.0.0.
HOST=127.0.0.1

# Origem pública do app: usada na checagem de CSRF e para montar links de convite/redefinição.
APP_ORIGIN=http://127.0.0.1:5310

# development | test | production (production liga cookie Secure/__Host- e desliga o Swagger UI).
NODE_ENV=development

# true quando a API roda atrás do Caddy (IP real em request.ip).
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
