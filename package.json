{
  "name": "@ronin/api",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "start:prod": "node dist/migrate.js && node --enable-source-maps dist/server.js",
    "build": "pnpm --filter @raphasparda/ronin-shared run build && tsup",
    "typecheck": "tsc --noEmit && pnpm --filter @raphasparda/ronin-shared run typecheck",
    "test": "pnpm --filter @raphasparda/ronin-shared run test && vitest run",
    "test:api": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:dev": "node scripts/db-dev.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "shared:build": "pnpm --filter @raphasparda/ronin-shared run build",
    "shared:pack": "pnpm --filter @raphasparda/ronin-shared pack"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@raphasparda/ronin-shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "fractional-indexing": "^3.4.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "prettier": "^3.9.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
